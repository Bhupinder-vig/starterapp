<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StarterApp.Views.RentalsPage"
             Title="Rentals">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Button Text="Refresh Rentals"
                Command="{Binding LoadRentalsCommand}" />

        <CollectionView ItemsSource="{Binding Rentals}">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame Padding="10" Margin="5">

                        <VerticalStackLayout Spacing="5">

                            <Label Text="{Binding ItemName}"
                                   FontAttributes="Bold"
                                   FontSize="18"/>

                            <Label Text="{Binding UserName}" />

                            <Label Text="{Binding Status}"
                                   TextColor="DarkBlue"
                                   FontAttributes="Bold"/>

                            <HorizontalStackLayout Spacing="10">

                                <Button Text="Approve"
                                        BackgroundColor="Green"
                                        TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ApproveCommand}"
                                        CommandParameter="{Binding}" />

                                <Button Text="Reject"
                                        BackgroundColor="Red"
                                        TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RejectCommand}"
                                        CommandParameter="{Binding}" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>