<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StarterApp.Views.NearbyItemsPage"
             Title="Nearby Items">

    <VerticalStackLayout Padding="20" Spacing="15">

        <!-- Refresh Button -->
        <Button Text="Find Nearby Items"
                Command="{Binding LoadNearbyItemsCommand}" />

        <!-- List of nearby items -->
        <CollectionView ItemsSource="{Binding NearbyItems}">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5">

                        <VerticalStackLayout Spacing="5">

                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   FontSize="18" />

                            <Label Text="{Binding Description}" />

                            <Label Text="{Binding PricePerDay, StringFormat='£{0}/day'}" />

                            <Label Text="{Binding Location}"
                                   FontAttributes="Italic"
                                   TextColor="Gray" />

                        </VerticalStackLayout>

                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>